# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.hg/
.hgignore
.hg_archival.txt
# Packages
# charts/*.tgz intentionally not ignored — helm needs it
# *.tgz at root is ignored via .gitignore, not .helmignore
# Misc
.github/
deploy*.sh
values.secret.yaml
